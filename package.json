{
  "name": "ingenieria-sei",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "backend": "npm --prefix backend run dev",
    "backend:install": "npm --prefix backend install",
    "db:up": "docker compose -f database/docker-compose.yml up -d",
    "db:down": "docker compose -f database/docker-compose.yml down",
    "db:init": "node backend/scripts/init-db.mjs",
    "db:backup": "node backend/scripts/backup-db.mjs && node backend/scripts/backup-archivos.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
