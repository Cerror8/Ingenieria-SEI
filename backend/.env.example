CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Sesiones
SESSION_TTL_DIAS=7

# Carpeta local donde se guardan los archivos subidos (relativa a backend/)
UPLOAD_DIR=uploads

# Administrador local (se crea al arrancar el backend si no existe)
