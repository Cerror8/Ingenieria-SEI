PORT=4000
DATABASE_URL=postgres://sei:sei_dev_password@localhost:5433/sei_rap
# Postgres gestionado (Neon, Supabase, Railway) usa TLS. También se activa solo
# si DATABASE_URL incluye ?sslmode=require. Déjalo sin definir en local.
# PGSSL=true
CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Sesiones
SESSION_TTL_DIAS=7

# Carpeta local donde se guardan los archivos subidos (relativa a backend/).
# En Vercel se usa /tmp/uploads automáticamente (efímero).
UPLOAD_DIR=uploads

# Vercel Blob: si defines este token (o conectas un Blob store al proyecto),
# los archivos se guardan ahí y sobreviven a los despliegues. Sin token,
# se usa el disco local (backend/uploads) como antes.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Administrador local (se crea al arrancar el backend si no existe)
ADMIN_EMAIL=admin@unicesmag.edu.co
ADMIN_PASSWORD=Admin12345!

# Seguridad: solo correos de este dominio pueden entrar con Google.
# Déjalo vacío para permitir cualquier cuenta de Google.
ALLOWED_DOMAIN=

# Google Cloud Console → Credenciales → OAuth 2.0
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Correo saliente (Gmail con contraseña de aplicación, requiere 2FA).
# También sirve cualquier proveedor SMTP (Brevo, Resend, Outlook).
# Si SMTP_USER o SMTP_PASS faltan, los avisos por correo se omiten sin fallar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contrasena-de-aplicacion
SMTP_FROM=tu-cuenta@gmail.com

# WhatsApp Business Cloud API (opcional). Sin WHATSAPP_TOKEN y
# WHATSAPP_PHONE_NUMBER_ID los recordatorios solo salen por correo.
# Requiere una plantilla de utilidad aprobada por Meta con dos variables:
# {{1}} nombre y {{2}} resumen de tareas.
# WHATSAPP_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_TEMPLATE_RECORDATORIO=recordatorio_tareas
# WHATSAPP_TEMPLATE_IDIOMA=es
# WHATSAPP_PAIS=57
# WHATSAPP_API_VERSION=v23.0

# Cron diario de recordatorios (Vercel lo invoca con Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=cadena-larga-aleatoria

NODE_ENV=development
